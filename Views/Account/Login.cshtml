@using HotelBookingSystem.ViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-vh-100 d-flex align-items-center py-5"
     style="background:linear-gradient(135deg,var(--navy-dark) 0%,var(--navy) 60%,var(--navy-light) 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="text-center mb-4">
                    <div style="font-size:2.5rem;font-family:'Poppins',sans-serif;font-weight:800;color:#fff;letter-spacing:1px;">
                        GRAND<span style="color:var(--gold);">HORIZON</span>
                    </div>
                    <p style="color:rgba(255,255,255,0.6);font-size:0.9rem;">Sign in to your account</p>
                </div>

                <div class="card border-0 rounded-4 shadow-lg" style="background:var(--white);">
                    <div class="card-body p-4">
                        <div asp-validation-summary="All" class="alert alert-danger py-2 mb-3 d-none"></div>

                        <form asp-controller="Account" asp-action="Login" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    <i class="bi bi-envelope me-1" style="color:var(--gold);"></i>Email Address
                                </label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="admin@hotel.com" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Password" class="form-label fw-semibold">
                                    <i class="bi bi-lock me-1" style="color:var(--gold);"></i>Password
                                </label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-4 form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label text-muted">Remember me for 14 days</label>
                            </div>

                            <button type="submit" class="btn btn-gold w-100 py-3" style="font-size:1rem;">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                            </button>
                        </form>

                        <hr class="my-4" />
                        <div class="text-center">
                            <small class="text-muted">Don't have an account?</small><br />
                            <a asp-controller="Account" asp-action="Register"
                               class="btn btn-outline-secondary mt-2 w-100">
                                <i class="bi bi-person-plus me-1"></i>Create Guest Account
                            </a>
                        </div>

                        <div class="mt-4 p-3 rounded-3" style="background:rgba(197,160,89,0.08);border:1px solid rgba(197,160,89,0.25);">
                            <small class="fw-semibold d-block mb-1" style="color:var(--navy);">
                                <i class="bi bi-info-circle me-1" style="color:var(--gold);"></i>Demo Credentials
                            </small>
                            <small class="text-muted d-block">🛡️ Admin: <strong>admin@hotel.com</strong> / <strong>Admin@123</strong></small>
                            <small class="text-muted d-block">👩‍💼 Staff: <strong>staff@hotel.com</strong> / <strong>Staff@123</strong></small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Show validation summary if has errors
        const vs = document.querySelector('[data-valmsg-summary]');
        if (vs && vs.querySelectorAll('li').length > 0) vs.classList.remove('d-none');
    </script>
}
