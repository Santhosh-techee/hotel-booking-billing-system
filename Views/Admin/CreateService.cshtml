@using HotelBookingSystem.Models
@model Service
@{
    ViewData["Title"] = "New Service";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-plus-circle me-2"></i>Add Extra Service</h1>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-section">
                <form asp-controller="Admin" asp-action="CreateService" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                    <div class="form-section-title">
                        <i class="bi bi-bag-heart me-2" style="color:var(--gold);"></i>Service Details
                    </div>

                    <div class="mb-3">
                        <label asp-for="ServiceName" class="form-label">Service Name <span class="text-danger">*</span></label>
                        <input asp-for="ServiceName" class="form-control" placeholder="e.g. Breakfast Buffet" />
                        <span asp-validation-for="ServiceName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label">Price (₹) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="Price" type="number" class="form-control" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch" checked />
                        <label asp-for="IsActive" class="form-check-label">Service is Active</label>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-gold flex-grow-1 py-3">
                            <i class="bi bi-check-circle me-1"></i>Create Service
                        </button>
                        <a asp-controller="Admin" asp-action="Services" class="btn btn-outline-secondary py-3 px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
