@using HotelBookingSystem.Models
@model IEnumerable<Invoice>
@{
    ViewData["Title"] = "Invoices";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string search = ViewBag.Search as string ?? "";
    string paymentFilter = ViewBag.PaymentFilter as string ?? "";
    string dateFrom = ViewBag.From as string ?? "";
    string dateTo = ViewBag.To as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? Model.Count();
    decimal totalRevenue = ViewBag.TotalRevenueFiltered ?? Model.Where(i => i.PaymentStatus == PaymentStatus.Paid).Sum(i => i.GrandTotal);
}

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1><i class="bi bi-receipt me-2"></i>Invoices</h1>
                <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard" style="color:rgba(255,255,255,0.65);">Dashboard</a></li>
                    <li class="breadcrumb-item active">Invoices</li>
                </ol></nav>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-success px-3 py-2">
                    Revenue: ₹@totalRevenue.ToString("N0")
                </span>
                <span class="badge bg-dark px-3 py-2">@totalRecords invoice(s)</span>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- Search & Filters -->
    <div class="card-hotel p-3 mb-4">
        <form method="get" asp-controller="Admin" asp-action="Invoices" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="search" class="form-control form-control-sm"
                       value="@search" placeholder="Invoice #, booking ref, guest..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Payment Status</label>
                <select name="paymentFilter" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="Pending" selected="@(paymentFilter == "Pending")">Pending</option>
                    <option value="Paid" selected="@(paymentFilter == "Paid")">Paid</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">From Date</label>
                <input type="date" name="from" class="form-control form-control-sm" value="@dateFrom" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">To Date</label>
                <input type="date" name="to" class="form-control form-control-sm" value="@dateTo" />
            </div>
            <div class="col-md-3">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-gold btn-sm flex-grow-1">
                        <i class="bi bi-funnel me-1"></i>Apply
                    </button>
                    <a asp-controller="Admin" asp-action="Invoices" class="btn btn-outline-secondary btn-sm">Clear</a>
                </div>
            </div>
        </form>
    </div>

    <div class="card-hotel overflow-hidden">
        <div class="table-responsive">
            <table class="table-hotel mb-0">
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Booking Ref</th>
                        <th>Guest</th>
                        <th class="text-end">Room</th>
                        <th class="text-end">Services</th>
                        <th class="text-end">GST</th>
                        <th class="text-end">Total</th>
                        <th>Payment</th>
                        <th>Mode</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        <tr>
                            <td>
                                <strong class="text-navy">@inv.InvoiceNumber</strong>
                                <br /><small class="text-muted">@inv.CreatedAt.ToString("dd MMM yy")</small>
                            </td>
                            <td>@inv.Booking?.BookingRef</td>
                            <td>@inv.Booking?.GuestName</td>
                            <td class="text-end">₹@inv.RoomCharges.ToString("N0")</td>
                            <td class="text-end">₹@inv.ServiceCharges.ToString("N0")</td>
                            <td class="text-end">₹@inv.TaxAmount.ToString("N0")</td>
                            <td class="text-end fw-bold" style="color:var(--gold);">₹@inv.GrandTotal.ToString("N0")</td>
                            <td>
                                @if (inv.PaymentStatus == PaymentStatus.Paid)
                                {
                                    <span class="status-badge badge-paid">Paid</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-pending">Pending</span>
                                }
                            </td>
                            <td><small>@inv.PaymentMode</small></td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-controller="Invoice" asp-action="Details" asp-route-invoiceId="@inv.InvoiceId"
                                       class="btn btn-sm btn-outline-primary" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-controller="Invoice" asp-action="DownloadPdf" asp-route-invoiceId="@inv.InvoiceId"
                                       class="btn btn-sm btn-outline-success" title="PDF">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div style="font-size:3rem;">🧾</div>
                <p class="text-muted mt-2">No invoices match your search or filter.</p>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Invoices pagination" class="mt-4">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="Admin" asp-action="Invoices"
                       asp-route-search="@search" asp-route-paymentFilter="@paymentFilter"
                       asp-route-from="@dateFrom" asp-route-to="@dateTo" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-controller="Admin" asp-action="Invoices"
                           asp-route-search="@search" asp-route-paymentFilter="@paymentFilter"
                           asp-route-from="@dateFrom" asp-route-to="@dateTo" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-controller="Admin" asp-action="Invoices"
                       asp-route-search="@search" asp-route-paymentFilter="@paymentFilter"
                       asp-route-from="@dateFrom" asp-route-to="@dateTo" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
