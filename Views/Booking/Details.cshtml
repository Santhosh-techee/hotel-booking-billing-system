@using HotelBookingSystem.Models
@model Booking
@{
    ViewData["Title"] = "Booking Details — " + Model.BookingRef;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var nights = Math.Max(1, (Model.CheckOutDate - Model.CheckInDate).Days);
    var roomCharges = (Model.Room?.RoomType?.BasePrice ?? 0) * nights;
    var serviceCharges = Model.BookingServices?.Sum(bs => bs.UnitPrice * bs.Quantity) ?? 0;
    bool isStaff = User.IsInRole("Admin") || User.IsInRole("Receptionist");
    var statusClass = Model.BookingStatus switch {
        BookingStatus.Confirmed  => "badge-confirmed",
        BookingStatus.CheckedIn  => "badge-checkedin",
        BookingStatus.CheckedOut => "badge-checkedout",
        BookingStatus.Cancelled  => "badge-cancelled",
        _                        => "badge-pending"
    };
}

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1><i class="bi bi-journal-text me-2"></i>Booking @Model.BookingRef</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-controller="Booking" asp-action="MyBookings" style="color:rgba(255,255,255,0.65);">Bookings</a></li>
                        <li class="breadcrumb-item active">@Model.BookingRef</li>
                    </ol>
                </nav>
            </div>
            <span class="status-badge @statusClass fs-6 px-3 py-2">@Model.BookingStatus</span>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card-hotel p-4 mb-4">
                <h5 class="section-title">Stay &amp; Guest Summary</h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <small class="text-muted">Guest Name</small>
                        <div class="fw-bold">@Model.GuestName</div>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted">Phone Number</small>
                        <div>@Model.GuestPhone</div>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted">Room</small>
                        <div class="fw-bold text-navy">Room @Model.Room?.RoomNumber — @Model.Room?.RoomType?.Name</div>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted">Guests</small>
                        <div>@Model.GuestCount Guest@(Model.GuestCount > 1 ? "s" : "")</div>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted">Check-In</small>
                        <div class="fw-semibold">@Model.CheckInDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted">Check-Out</small>
                        <div class="fw-semibold">@Model.CheckOutDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted">Duration</small>
                        <div class="fw-semibold">@nights Night@(nights > 1 ? "s" : "")</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.IdProofNumber))
                    {
                        <div class="col-sm-6">
                            <small class="text-muted">ID Proof Recorded</small>
                            <div class="fw-semibold">@Model.IdProofNumber</div>
                        </div>
                    }
                </div>
            </div>

            @if (Model.BookingServices != null && Model.BookingServices.Any())
            {
                <div class="card-hotel overflow-hidden mb-4">
                    <div class="p-3 border-bottom"><h6 class="mb-0 text-navy">Extra Services</h6></div>
                    <div class="table-responsive">
                        <table class="table-hotel mb-0">
                            <thead>
                                <tr>
                                    <th>Service</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bs in Model.BookingServices)
                                {
                                    <tr>
                                        <td>@bs.Service?.ServiceName</td>
                                        <td class="text-center">@bs.Quantity</td>
                                        <td class="text-end">₹@bs.UnitPrice.ToString("N2")</td>
                                        <td class="text-end fw-semibold">₹@((bs.UnitPrice * bs.Quantity).ToString("N2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="running-total-panel">
                <h5><i class="bi bi-receipt me-2"></i>Charges Estimate</h5>
                <div class="mt-3">
                    <div class="running-total-line">
                        <span>Room (@nights night@(nights > 1 ? "s" : ""))</span>
                        <span>₹@roomCharges.ToString("N2")</span>
                    </div>
                    <div class="running-total-line">
                        <span>Extra Services</span>
                        <span>₹@serviceCharges.ToString("N2")</span>
                    </div>
                </div>
                <hr style="border-color:rgba(255,255,255,0.2);" />
                <div class="d-flex justify-content-between align-items-center">
                    <span>Subtotal</span>
                    <span class="running-grand">₹@((roomCharges + serviceCharges).ToString("N2"))</span>
                </div>

                <div class="d-grid gap-2 mt-4">
                    @if (Model.Invoice != null)
                    {
                        <a asp-controller="Invoice" asp-action="Details" asp-route-invoiceId="@Model.Invoice.InvoiceId" class="btn btn-gold">
                            <i class="bi bi-receipt me-1"></i>View Tax Invoice
                        </a>
                        <a asp-controller="Invoice" asp-action="DownloadPdf" asp-route-invoiceId="@Model.Invoice.InvoiceId" class="btn btn-outline-light">
                            <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
                        </a>
                    }
                    @if (isStaff && Model.BookingStatus == BookingStatus.Confirmed)
                    {
                        <a asp-controller="FrontDesk" asp-action="CheckIn" asp-route-bookingId="@Model.BookingId" class="btn btn-gold">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Check In Guest
                        </a>
                    }
                    @if (isStaff && Model.BookingStatus == BookingStatus.CheckedIn)
                    {
                        <a asp-controller="FrontDesk" asp-action="ActiveStay" asp-route-bookingId="@Model.BookingId" class="btn btn-gold">
                            <i class="bi bi-eye me-1"></i>Manage Active Stay
                        </a>
                    }
                    <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-light">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
