@using HotelBookingSystem.Models
@model IEnumerable<Booking>
@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isStaff = User.IsInRole("Admin") || User.IsInRole("Receptionist");
}

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1><i class="bi bi-journal-bookmark me-2"></i>@(isStaff ? "All Bookings" : "My Bookings")</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,0.65);">Home</a>
                        </li>
                        <li class="breadcrumb-item active">Bookings</li>
                    </ol>
                </nav>
            </div>
            @if (!isStaff)
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-gold">
                    <i class="bi bi-plus-circle me-1"></i>New Booking
                </a>
            }
        </div>
    </div>
</div>

<div class="container pb-5">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:4rem;">📋</div>
            <h3 class="text-navy mt-3">No bookings found</h3>
            <p class="text-muted">@(isStaff ? "No bookings have been made yet." : "Start your luxury stay by searching for a room.")</p>
            @if (!isStaff)
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-gold mt-2">
                    <i class="bi bi-search me-1"></i>Search Rooms
                </a>
            }
        </div>
    }
    else
    {
        <div class="card-hotel overflow-hidden">
            <div class="table-responsive">
                <table class="table-hotel mb-0">
                    <thead>
                        <tr>
                            <th>Booking Ref</th>
                            @if (isStaff) { <th>Guest</th> }
                            <th>Room</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th>Nights</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.OrderByDescending(x => x.CreatedAt))
                        {
                            var statusClass = b.BookingStatus switch {
                                BookingStatus.Confirmed  => "badge-confirmed",
                                BookingStatus.CheckedIn  => "badge-checkedin",
                                BookingStatus.CheckedOut => "badge-checkedout",
                                BookingStatus.Cancelled  => "badge-cancelled",
                                _                        => "badge-pending"
                            };
                            var nights = Math.Max(1, (b.CheckOutDate - b.CheckInDate).Days);
                            <tr>
                                <td>
                                    <strong class="text-navy">@b.BookingRef</strong>
                                    <br /><small class="text-muted">@b.CreatedAt.ToString("dd MMM yy")</small>
                                </td>
                                @if (isStaff)
                                {
                                    <td>
                                        @b.GuestName
                                        <br /><small class="text-muted">@b.GuestPhone</small>
                                    </td>
                                }
                                <td>
                                    Room @b.Room?.RoomNumber
                                    <br /><small class="text-muted">@b.Room?.RoomType?.Name</small>
                                </td>
                                <td>@b.CheckInDate.ToString("dd MMM yyyy")</td>
                                <td>@b.CheckOutDate.ToString("dd MMM yyyy")</td>
                                <td>@nights</td>
                                <td><span class="status-badge @statusClass">@b.BookingStatus</span></td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <a asp-controller="Booking" asp-action="Details"
                                           asp-route-id="@b.BookingId"
                                           class="btn btn-sm btn-outline-secondary" title="Booking Details">
                                            <i class="bi bi-info-circle"></i>
                                        </a>
                                        @if (b.BookingStatus == BookingStatus.Confirmed || b.BookingStatus == BookingStatus.Pending)
                                        {
                                            <form asp-controller="Booking" asp-action="Cancel" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@b.BookingId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        title="Cancel Booking"
                                                        data-confirm="Are you sure you want to cancel booking @b.BookingRef?">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (b.Invoice != null)
                                        {
                                            <a asp-controller="Invoice" asp-action="Details"
                                               asp-route-invoiceId="@b.Invoice.InvoiceId"
                                               class="btn btn-sm btn-outline-primary" title="View Invoice">
                                                <i class="bi bi-receipt"></i>
                                            </a>
                                            <a asp-controller="Invoice" asp-action="DownloadPdf"
                                               asp-route-invoiceId="@b.Invoice.InvoiceId"
                                               class="btn btn-sm btn-outline-success" title="Download PDF Invoice">
                                                <i class="bi bi-file-earmark-pdf"></i>
                                            </a>
                                        }
                                        @if (isStaff && b.BookingStatus == BookingStatus.Confirmed)
                                        {
                                            <a asp-controller="FrontDesk" asp-action="CheckIn"
                                               asp-route-bookingId="@b.BookingId"
                                               class="btn btn-sm btn-navy" title="Check In">
                                                <i class="bi bi-box-arrow-in-right"></i>
                                            </a>
                                        }
                                        @if (isStaff && b.BookingStatus == BookingStatus.CheckedIn)
                                        {
                                            <a asp-controller="FrontDesk" asp-action="ActiveStay"
                                               asp-route-bookingId="@b.BookingId"
                                               class="btn btn-sm btn-gold" title="Manage Stay">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
