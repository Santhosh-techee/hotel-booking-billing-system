@using HotelBookingSystem.Models
@model Booking
@{
    ViewData["Title"] = "Active Stay — Room " + Model.Room?.RoomNumber;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var nights = Math.Max(1, (Model.CheckOutDate - Model.CheckInDate).Days);
    var roomCharges = (Model.Room?.RoomType?.BasePrice ?? 0) * nights;
    var serviceCharges = Model.BookingServices?.Sum(bs => bs.UnitPrice * bs.Quantity) ?? 0;
    var allServices = ViewBag.AllServices as IEnumerable<Service> ?? Enumerable.Empty<Service>();
    var gstLabel = (Model.Room?.RoomType?.BasePrice ?? 0) <= 7500 ? "12%" : "18%";
}

<input type="hidden" id="activeBookingId" value="@Model.BookingId" />

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1><i class="bi bi-door-open me-2"></i>Active Stay — Room @Model.Room?.RoomNumber</h1>
                <p class="mb-0" style="color:rgba(255,255,255,0.7);">
                    @Model.GuestName &bull; @Model.BookingRef &bull; @Model.GuestPhone
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="FrontDesk" asp-action="Checkout" asp-route-bookingId="@Model.BookingId"
                   class="btn btn-gold">
                    <i class="bi bi-box-arrow-right me-1"></i>Proceed to Checkout
                </a>
                <a asp-controller="FrontDesk" asp-action="Index" class="btn btn-outline-light">
                    Room Board
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4">

        <!-- Left: Services Panel -->
        <div class="col-lg-8">

            <!-- Add Service -->
            <div class="card-hotel p-4 mb-4">
                <h5 class="section-title">Add Extra Service</h5>
                <!-- Invisible AntiForgery token for AJAX calls -->
                @Html.AntiForgeryToken()

                <div class="row g-3 align-items-end">
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold">Service</label>
                        <select id="serviceSelect" class="form-select">
                            <option value="">— Select a service —</option>
                            @foreach (var svc in allServices)
                            {
                                <option value="@svc.ServiceId">@svc.ServiceName — ₹@svc.Price.ToString("N0")</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label fw-semibold">Quantity</label>
                        <input type="number" id="serviceQty" class="form-control" value="1" min="1" max="50" />
                    </div>
                    <div class="col-sm-3">
                        <button type="button" class="btn btn-gold w-100" onclick="addService(@Model.BookingId)">
                            <i class="bi bi-plus-circle me-1"></i>Add
                        </button>
                    </div>
                </div>
            </div>

            <!-- Services Table -->
            <div class="card-hotel overflow-hidden">
                <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-navy">
                        <i class="bi bi-bag-heart me-2" style="color:var(--gold);"></i>Extra Services Charged
                    </h5>
                    <span class="badge bg-navy">@(Model.BookingServices?.Count ?? 0) item(s)</span>
                </div>
                <div class="table-responsive">
                    <table class="table-hotel mb-0">
                        <thead>
                            <tr>
                                <th>Service</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Remove</th>
                            </tr>
                        </thead>
                        <tbody id="servicesTableBody">
                            @if (Model.BookingServices == null || !Model.BookingServices.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        <i class="bi bi-bag me-1"></i>No extra services added yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var bs in Model.BookingServices)
                                {
                                    <tr>
                                        <td>@bs.Service?.ServiceName</td>
                                        <td class="text-center">@bs.Quantity</td>
                                        <td class="text-end">₹@bs.UnitPrice.ToString("N2")</td>
                                        <td class="text-end fw-semibold">₹@((bs.UnitPrice * bs.Quantity).ToString("N2"))</td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-danger py-0 px-2"
                                                    onclick="removeService(@bs.Id, @Model.BookingId)">
                                                &times;
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Stay Info -->
            <div class="card-hotel p-4 mt-4">
                <h5 class="section-title">Stay Information</h5>
                <div class="row g-3">
                    <div class="col-sm-3">
                        <small class="text-muted">Room Type</small>
                        <div class="fw-semibold">@Model.Room?.RoomType?.Name</div>
                    </div>
                    <div class="col-sm-3">
                        <small class="text-muted">Check-In</small>
                        <div class="fw-semibold">@Model.CheckInDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="col-sm-3">
                        <small class="text-muted">Check-Out</small>
                        <div class="fw-semibold">@Model.CheckOutDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="col-sm-3">
                        <small class="text-muted">ID Proof</small>
                        <div class="fw-semibold">@Model.IdProofNumber</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Running Total -->
        <div class="col-lg-4">
            <div class="running-total-panel" style="position:sticky;top:80px;">
                <h5><i class="bi bi-calculator me-2"></i>Running Total</h5>

                <div class="mt-3">
                    <div class="running-total-line">
                        <span>Room @Model.Room?.RoomNumber (@nights nights)</span>
                        <span id="rtRoomTotal">₹@roomCharges.ToString("N2")</span>
                    </div>
                    <div class="running-total-line">
                        <span>Extra Services</span>
                        <span id="rtServiceTotal">₹@serviceCharges.ToString("N2")</span>
                    </div>
                    <div class="running-total-line">
                        <span>GST (@gstLabel)</span>
                        <span style="color:rgba(255,255,255,0.5);">Calculated at checkout</span>
                    </div>
                </div>

                <hr style="border-color:rgba(255,255,255,0.2);" />

                <div class="d-flex justify-content-between align-items-center">
                    <span style="color:rgba(255,255,255,0.75);">Est. Total (excl. GST)</span>
                    <span class="running-grand" id="rtGrandTotal">₹@((roomCharges + serviceCharges).ToString("N2"))</span>
                </div>

                <small style="color:rgba(255,255,255,0.4);font-size:0.72rem;display:block;margin-top:0.5rem;">
                    @nights night@(nights > 1 ? "s" : "") &bull; @Model.GuestCount guest@(Model.GuestCount > 1 ? "s" : "")
                </small>

                <div class="mt-4">
                    <a asp-controller="FrontDesk" asp-action="Checkout" asp-route-bookingId="@Model.BookingId"
                       class="btn btn-gold w-100 py-3" style="font-size:1rem;">
                        <i class="bi bi-box-arrow-right me-2"></i>Checkout & Invoice
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
