@using HotelBookingSystem.ViewModels
@model CheckInViewModel
@{
    ViewData["Title"] = "Guest Check-In";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-box-arrow-in-right me-2"></i>Guest Check-In</h1>
        @if (Model.Booking != null)
        {
            <p class="mb-0" style="color:rgba(255,255,255,0.7);">
                @Model.Booking.GuestName &bull; @Model.Booking.BookingRef
            </p>
        }
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            @if (Model.Booking != null)
            {
                <!-- Booking Info Card -->
                <div class="card-hotel p-4 mb-4">
                    <h5 class="section-title">Booking Details</h5>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <small class="text-muted">Booking Reference</small>
                            <div class="fw-bold text-navy">@Model.Booking.BookingRef</div>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted">Guest Name</small>
                            <div class="fw-bold">@Model.Booking.GuestName</div>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted">Phone</small>
                            <div>@Model.Booking.GuestPhone</div>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted">Room</small>
                            <div class="fw-bold">Room @Model.Booking.Room?.RoomNumber — @Model.Booking.Room?.RoomType?.Name</div>
                        </div>
                        <div class="col-sm-4">
                            <small class="text-muted">Check-In</small>
                            <div class="fw-bold text-success">@Model.Booking.CheckInDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="col-sm-4">
                            <small class="text-muted">Check-Out</small>
                            <div class="fw-bold">@Model.Booking.CheckOutDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="col-sm-4">
                            <small class="text-muted">Guests</small>
                            <div class="fw-bold">@Model.Booking.GuestCount</div>
                        </div>
                    </div>
                </div>

                <!-- Check-In Form -->
                <div class="form-section">
                    <form asp-controller="FrontDesk" asp-action="CheckIn" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="BookingId" type="hidden" />

                        <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                        <div class="form-section-title">
                            <i class="bi bi-card-text me-2" style="color:var(--gold);"></i>ID Verification
                        </div>

                        <div class="mb-4">
                            <label asp-for="IdProofNumber" class="form-label fw-semibold">
                                ID Proof Number <span class="text-danger">*</span>
                            </label>
                            <input asp-for="IdProofNumber" class="form-control form-control-lg"
                                   placeholder="Aadhaar / Passport / Driving Licence / Voter ID" />
                            <span asp-validation-for="IdProofNumber" class="text-danger small"></span>
                            <div class="form-text">Please record the guest's government-issued ID document number.</div>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-gold flex-grow-1 py-3" style="font-size:1rem;">
                                <i class="bi bi-check-circle me-2"></i>Confirm Check-In & Assign Room
                            </button>
                            <a asp-controller="FrontDesk" asp-action="Arrivals"
                               class="btn btn-outline-secondary py-3 px-4">
                                Back
                            </a>
                        </div>
                    </form>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div style="font-size:4rem;">❌</div>
                    <h3 class="text-navy mt-3">Booking Not Found</h3>
                    <a asp-controller="FrontDesk" asp-action="Arrivals" class="btn btn-gold mt-3">
                        Back to Arrivals
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
