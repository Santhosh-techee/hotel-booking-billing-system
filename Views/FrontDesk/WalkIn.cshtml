@using HotelBookingSystem.ViewModels
@model WalkInBookingViewModel
@{
    ViewData["Title"] = "Walk-In Booking & Check-In";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1><i class="bi bi-person-plus me-2"></i>Walk-In Booking &amp; Check-In</h1>
                <p class="mb-0" style="color:rgba(255,255,255,0.7);">
                    Create an immediate reservation and check in a walk-in guest
                </p>
            </div>
            <a asp-controller="FrontDesk" asp-action="Index" class="btn btn-outline-light">
                <i class="bi bi-grid-3x3-gap me-1"></i>Room Board
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-section">
                <form asp-controller="FrontDesk" asp-action="WalkIn" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger mb-3 d-none" id="walkInValSummary"></div>

                    <div class="form-section-title">
                        <i class="bi bi-door-open me-2" style="color:var(--gold);"></i>Select Room &amp; Dates
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label asp-for="RoomId" class="form-label fw-semibold">Room <span class="text-danger">*</span></label>
                            <select asp-for="RoomId" class="form-select">
                                <option value="">— Select an available room —</option>
                                @foreach (var r in Model.AvailableRooms.OrderBy(x => x.RoomNumber))
                                {
                                    <option value="@r.RoomId">
                                        Room @r.RoomNumber — @r.RoomType?.Name (₹@r.RoomType?.BasePrice.ToString("N0")/night, Max @r.RoomType?.MaxGuests guests, Status: @r.Status)
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="RoomId" class="text-danger small"></span>
                        </div>

                        <div class="col-sm-4">
                            <label asp-for="CheckInDate" class="form-label fw-semibold">Check-In Date <span class="text-danger">*</span></label>
                            <input asp-for="CheckInDate" type="date" class="form-control" id="CheckInDate" />
                            <span asp-validation-for="CheckInDate" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="CheckOutDate" class="form-label fw-semibold">Check-Out Date <span class="text-danger">*</span></label>
                            <input asp-for="CheckOutDate" type="date" class="form-control" id="CheckOutDate" />
                            <span asp-validation-for="CheckOutDate" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="GuestCount" class="form-label fw-semibold">Guests <span class="text-danger">*</span></label>
                            <input asp-for="GuestCount" type="number" class="form-control" min="1" max="10" />
                            <span asp-validation-for="GuestCount" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-section-title">
                        <i class="bi bi-person-vcard me-2" style="color:var(--gold);"></i>Guest &amp; ID Verification
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="GuestName" class="form-label fw-semibold">Guest Full Name <span class="text-danger">*</span></label>
                            <input asp-for="GuestName" class="form-control" placeholder="Full name as per ID" />
                            <span asp-validation-for="GuestName" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="GuestPhone" class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="GuestPhone" class="form-control" placeholder="+91 XXXXX XXXXX" />
                            <span asp-validation-for="GuestPhone" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="IdProofNumber" class="form-label fw-semibold">Government ID Proof Number <span class="text-danger">*</span></label>
                            <input asp-for="IdProofNumber" class="form-control" placeholder="Aadhaar / Passport / Driving Licence" />
                            <span asp-validation-for="IdProofNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-gold flex-grow-1 py-3" style="font-size:1rem;">
                            <i class="bi bi-check-circle me-2"></i>Create Walk-In &amp; Check In Now
                        </button>
                        <a asp-controller="FrontDesk" asp-action="Index" class="btn btn-outline-secondary py-3 px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const vs = document.getElementById('walkInValSummary');
        if (vs && vs.querySelectorAll('li').length > 0) vs.classList.remove('d-none');
    </script>
}
