@using HotelBookingSystem.ViewModels
@model RoomSearchViewModel
@{
    ViewData["Title"] = "Luxury Hotel Rooms";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 hero-content">
                <div class="mb-3">
                    <span class="badge px-3 py-2 rounded-pill fw-semibold" style="background:var(--gold);color:#fff;">
                        ⭐ Rated #1 Luxury Hotel 2026
                    </span>
                </div>
                <h1 class="hero-title">
                    Experience<br><span class="title-gold">Unparalleled</span><br>Luxury
                </h1>
                <p class="hero-subtitle">
                    Grand Horizon Hotel offers world-class accommodations in the heart of the city. Where every detail is crafted for your comfort.
                </p>
                <ul class="hero-features">
                    <li>Free high-speed Wi-Fi in all rooms</li>
                    <li>24/7 concierge & room service</li>
                    <li>Award-winning restaurant & spa</li>
                    <li>Complimentary airport transfers available</li>
                </ul>
            </div>

            <div class="col-lg-6">
                <div class="search-card">
                    <div class="card-title">
                        <i class="bi bi-search text-gold me-2"></i>Find Your Perfect Room
                    </div>
                    <form asp-controller="Home" asp-action="Search" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="alert alert-danger py-2 mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")" id="validationSummary"></div>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="CheckInDate" class="form-label">
                                    <i class="bi bi-calendar-event me-1 text-gold"></i>Check-In
                                </label>
                                <input asp-for="CheckInDate" type="date" class="form-control" id="CheckInDate" required />
                                <span asp-validation-for="CheckInDate" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="CheckOutDate" class="form-label">
                                    <i class="bi bi-calendar-event me-1 text-gold"></i>Check-Out
                                </label>
                                <input asp-for="CheckOutDate" type="date" class="form-control" id="CheckOutDate" required />
                                <span asp-validation-for="CheckOutDate" class="text-danger small"></span>
                            </div>

                            <div class="col-sm-8">
                                <label asp-for="GuestCount" class="form-label">
                                    <i class="bi bi-people me-1 text-gold"></i>Guests
                                </label>
                                <select asp-for="GuestCount" class="form-select">
                                    @for (int i = 1; i <= 10; i++)
                                    {
                                        <option value="@i">@i Guest@(i > 1 ? "s" : "")</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-4 d-flex align-items-end">
                                <span id="nightsDisplay" class="badge bg-secondary w-100 py-2 text-center"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-gold w-100 mt-4 py-3" style="font-size:1rem;">
                            <i class="bi bi-search me-2"></i>Search Available Rooms
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Strip -->
<section class="py-4" style="background:var(--white);border-top:3px solid var(--gold);">
    <div class="container">
        <div class="row g-3 text-center">
            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="fs-2 mb-1">🏨</div>
                    <div class="fw-bold small text-navy">Premium Rooms</div>
                    <div class="text-muted" style="font-size:0.75rem;">5 unique room options</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="fs-2 mb-1">🛡️</div>
                    <div class="fw-bold small text-navy">Safe & Secure</div>
                    <div class="text-muted" style="font-size:0.75rem;">24/7 security & CCTV</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="fs-2 mb-1">🍽️</div>
                    <div class="fw-bold small text-navy">Fine Dining</div>
                    <div class="text-muted" style="font-size:0.75rem;">World-class cuisine</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="fs-2 mb-1">🚗</div>
                    <div class="fw-bold small text-navy">Free Parking</div>
                    <div class="text-muted" style="font-size:0.75rem;">Valet service available</div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
