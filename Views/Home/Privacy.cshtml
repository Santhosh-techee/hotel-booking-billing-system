@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-shield-check me-2"></i>Privacy Policy</h1>
        <p class="mb-0" style="color:rgba(255,255,255,0.7);">Grand Horizon Hotel — Data &amp; Guest Privacy Standards</p>
    </div>
</div>

<div class="container pb-5">
    <div class="card-hotel p-4 p-md-5">
        <h5 class="section-title">Guest Information &amp; Confidentiality</h5>
        <p class="text-muted">
            Grand Horizon Hotel collects only the personal and identification information necessary to confirm reservations,
            fulfill statutory check-in ID verification requirements, manage in-stay services, and generate GST-compliant tax invoices.
        </p>
        <h6 class="text-navy mt-4">Data Security</h6>
        <p class="text-muted mb-0">
            All account credentials are protected with ASP.NET Core Identity password hashing and role-based access controls.
            Reservation and billing records are accessible strictly to the booking guest and authorized hotel staff.
        </p>
    </div>
</div>
