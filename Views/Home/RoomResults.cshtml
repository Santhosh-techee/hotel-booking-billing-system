@using HotelBookingSystem.ViewModels
@model RoomResultsViewModel
@{
    ViewData["Title"] = "Available Rooms";
    var nights = Math.Max(1, (Model.SearchCriteria.CheckOutDate - Model.SearchCriteria.CheckInDate).Days);
}

<div class="page-header">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h1><i class="bi bi-door-open me-2"></i>Available Rooms</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none" style="color:rgba(255,255,255,0.65);">Home</a></li>
                        <li class="breadcrumb-item active">Search Results</li>
                    </ol>
                </nav>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-dark px-3 py-2">
                    <i class="bi bi-calendar-event me-1"></i>
                    @Model.SearchCriteria.CheckInDate.ToString("dd MMM") → @Model.SearchCriteria.CheckOutDate.ToString("dd MMM yyyy")
                </span>
                <span class="badge bg-dark px-3 py-2">
                    <i class="bi bi-moon me-1"></i>@nights Night@(nights > 1 ? "s" : "")
                </span>
                <span class="badge bg-dark px-3 py-2">
                    <i class="bi bi-people me-1"></i>@Model.SearchCriteria.GuestCount Guest@(Model.SearchCriteria.GuestCount > 1 ? "s" : "")
                </span>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- Modify Search -->
    <div class="card-hotel p-3 mb-4">
        <form asp-controller="Home" asp-action="Search" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Check-In</label>
                <input name="CheckInDate" type="date" class="form-control form-control-sm"
                       value="@Model.SearchCriteria.CheckInDate.ToString("yyyy-MM-dd")" id="CheckInDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Check-Out</label>
                <input name="CheckOutDate" type="date" class="form-control form-control-sm"
                       value="@Model.SearchCriteria.CheckOutDate.ToString("yyyy-MM-dd")" id="CheckOutDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Guests</label>
                <select name="GuestCount" class="form-select form-select-sm">
                    @for (int i = 1; i <= 10; i++)
                    {
                        <option value="@i" selected="@(i == Model.SearchCriteria.GuestCount)">@i</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <span id="nightsDisplay" class="badge bg-secondary w-100 py-2"></span>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-gold btn-sm w-100">
                    <i class="bi bi-search me-1"></i>Modify
                </button>
            </div>
        </form>
    </div>

    @if (!Model.AvailableRooms.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:4rem;">🏨</div>
            <h3 class="text-navy mt-3">No Rooms Available</h3>
            <p class="text-muted">No rooms match your search for the selected dates and guest count. Try different dates.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-gold mt-2">
                <i class="bi bi-arrow-left me-1"></i>Modify Search
            </a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <p class="text-muted mb-0">
                <strong class="text-navy">@Model.AvailableRooms.Count()</strong> room@(Model.AvailableRooms.Count() != 1 ? "s" : "") available
            </p>
        </div>

        <div class="row g-4">
            @foreach (var room in Model.AvailableRooms)
            {
                var totalPrice = room.RoomType.BasePrice * nights;
                <div class="col-md-6 col-lg-4">
                    <div class="card-hotel h-100">
                        @if (!string.IsNullOrEmpty(room.RoomType.ImageUrl))
                        {
                            <div style="overflow:hidden;height:200px;">
                                <img src="@room.RoomType.ImageUrl" class="card-img-top" alt="@room.RoomType.Name"
                                     style="width:100%;height:200px;object-fit:cover;transition:transform 0.3s;" />
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-navy" style="height:200px;">
                                <span style="font-size:4rem;">🏨</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="status-badge badge-available mb-1">Available</span>
                                    <h5 class="mb-0 mt-1 text-navy">Room @room.RoomNumber</h5>
                                    <small class="text-muted">@room.RoomType.Name &bull; Floor @room.Floor</small>
                                </div>
                                <div class="text-end">
                                    <div class="room-price">₹@room.RoomType.BasePrice.ToString("N0")</div>
                                    <small class="text-muted">/ night</small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-people-fill me-1"></i>Up to @room.RoomType.MaxGuests guests
                                </small>
                                <div>
                                    @foreach (var amenity in room.RoomType.Amenities.Split(',').Take(4))
                                    {
                                        <span class="amenity-tag">@amenity.Trim()</span>
                                    }
                                </div>
                            </div>

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center p-3 rounded mb-3"
                                     style="background:rgba(197,160,89,0.08);border:1px solid rgba(197,160,89,0.2);">
                                    <div>
                                        <small class="text-muted">Total for @nights night@(nights > 1 ? "s" : "")</small>
                                        <div class="fw-bold text-navy">₹@totalPrice.ToString("N0")</div>
                                    </div>
                                    <small class="text-muted">+GST applicable</small>
                                </div>

                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <a asp-controller="Booking" asp-action="Create"
                                       asp-route-roomId="@room.RoomId"
                                       asp-route-checkIn="@Model.SearchCriteria.CheckInDate.ToString("yyyy-MM-dd")"
                                       asp-route-checkOut="@Model.SearchCriteria.CheckOutDate.ToString("yyyy-MM-dd")"
                                       asp-route-guests="@Model.SearchCriteria.GuestCount"
                                       class="btn btn-gold w-100">
                                        <i class="bi bi-check2-circle me-1"></i>Book This Room
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login"
                                       asp-route-returnUrl="/Booking/Create?roomId=@room.RoomId&checkIn=@Model.SearchCriteria.CheckInDate.ToString("yyyy-MM-dd")&checkOut=@Model.SearchCriteria.CheckOutDate.ToString("yyyy-MM-dd")&guests=@Model.SearchCriteria.GuestCount"
                                       class="btn btn-gold w-100">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>Login to Book
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
