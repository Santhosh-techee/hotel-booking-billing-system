<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Grand Horizon Hotel – Luxury room booking and management system" />
    <title>@ViewData["Title"] – Grand Horizon Hotel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Toast Container -->
    <div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999;">
        @if (TempData["Success"] != null)
        {
            <div class="toast toast-hotel toast-success show align-items-center auto-toast" role="alert" aria-atomic="true">
                <div class="d-flex align-items-center p-3 gap-3">
                    <span style="font-size:1.1rem;color:#166534;font-weight:700;">✓</span>
                    <div class="flex-grow-1" style="font-size:0.875rem;color:#1F2937;">@TempData["Success"]</div>
                    <button type="button" class="btn-close btn-close-sm" onclick="this.closest('.toast').remove()"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast toast-hotel toast-error show align-items-center auto-toast" role="alert" aria-atomic="true">
                <div class="d-flex align-items-center p-3 gap-3">
                    <span style="font-size:1.1rem;color:#991B1B;font-weight:700;">✕</span>
                    <div class="flex-grow-1" style="font-size:0.875rem;color:#1F2937;">@TempData["Error"]</div>
                    <button type="button" class="btn-close btn-close-sm" onclick="this.closest('.toast').remove()"></button>
                </div>
            </div>
        }
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-hotel">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-building me-1"></i>GRAND<span class="brand-gold">HORIZON</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" style="color:rgba(255,255,255,0.8);">
                <i class="bi bi-list fs-4"></i>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i>Home
                        </a>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Guest / All users -->
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Booking" ? "active" : "")"
                               asp-controller="Booking" asp-action="MyBookings">
                                <i class="bi bi-calendar-check me-1"></i>My Bookings
                            </a>
                        </li>

                        @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                        {
                            <!-- Front Desk -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "FrontDesk" ? "active" : "")"
                                   href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-grid-3x3-gap me-1"></i>Front Desk
                                    <span class="nav-badge bg-info text-white">Staff</span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="FrontDesk" asp-action="Index">
                                        <i class="bi bi-grid-3x3-gap me-2"></i>Room Status Board
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="FrontDesk" asp-action="Arrivals">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>Arrivals / Check-In
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="FrontDesk" asp-action="WalkIn">
                                        <i class="bi bi-person-plus me-2"></i>Walk-In Booking
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Booking" asp-action="MyBookings">
                                        <i class="bi bi-list-ul me-2"></i>All Bookings
                                    </a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <!-- Admin -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"
                                   href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-shield-lock me-1"></i>Admin
                                    <span class="nav-badge bg-warning text-dark">Admin</span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="RoomTypes">
                                        <i class="bi bi-tags me-2"></i>Room Types
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Rooms">
                                        <i class="bi bi-door-open me-2"></i>Rooms
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Services">
                                        <i class="bi bi-bag-heart me-2"></i>Services
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Bookings">
                                        <i class="bi bi-journal-bookmark me-2"></i>All Bookings
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Invoices">
                                        <i class="bi bi-receipt me-2"></i>Invoices
                                    </a></li>
                                </ul>
                            </li>
                        }
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name?.Split('@')[0]
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="btn btn-gold btn-sm" asp-controller="Account" asp-action="Register">
                                Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-hotel">
        <div class="container text-center">
            <span>&copy; @DateTime.Now.Year Grand Horizon Hotel. Luxury Redefined, Every Stay.</span>
            <span class="mx-2">|</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
